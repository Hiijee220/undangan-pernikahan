rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /invitation/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'remajasilo.rs@gmail.com';
    }
    match /invitationImages/{document} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.email == 'remajasilo.rs@gmail.com'
                   && request.resource.data.dataUrl is string
                   && request.resource.data.dataUrl.size() < 1000000;
      allow delete: if request.auth != null && request.auth.token.email == 'remajasilo.rs@gmail.com';
    }
    match /invitationResponses/{responseId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'attendance', 'guestCount', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 2
                    && request.resource.data.message.size() <= 500
                    && request.resource.data.attendance in ['hadir', 'tidak_hadir', 'ragu']
                    && request.resource.data.guestCount is int
                    && request.resource.data.guestCount >= 0
                    && request.resource.data.guestCount <= 4
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if request.auth != null
                            && request.auth.token.email == 'remajasilo.rs@gmail.com';
    }
  }
}
