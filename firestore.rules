rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /invitation/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'remajasilo.rs@gmail.com';
    }
    match /invitationImages/{document} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.email == 'remajasilo.rs@gmail.com'
                   && request.resource.data.dataUrl is string
                   && request.resource.data.dataUrl.size() < 1000000;
      allow delete: if request.auth != null && request.auth.token.email == 'remajasilo.rs@gmail.com';
    }
  }
}
